# From @BotFather in Telegram: /newbot, then copy the token.
TELEGRAM_BOT_TOKEN=

# polling (default) or webhook. Webhook needs a public https address.
TELEGRAM_MODE=polling

# Webhook mode only: the app's public address, e.g. https://my-bot.fadehost.app
WEBHOOK_URL=
# Webhook mode, recommended: a random string; Telegram sends it with every update.
WEBHOOK_SECRET=
# Webhook mode: the port to listen on (FadeHost sets PORT for you).
PORT=3000
